#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer Src {
    float v[];
} src;

layout(set = 0, binding = 1, std430) buffer Dst {
    float v[];
} dst;

void main() {
    uint i = gl_GlobalInvocationID.x;
    dst.v[i] = src.v[i];
}
